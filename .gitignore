# Track only the essentials: this file, LICENSE, README, and the
# hfc-fieldloop skill. Everything else at the root (test data, other
# skill drafts, local config) stays untracked.

# Ignore everything by default
/*

# Un-ignore the files/dirs we do want tracked
!/.gitignore
!/LICENSE
!/README.md
!/skills

# Within skills/, ignore everything except hfc-fieldloop
/skills/*
!/skills/hfc-fieldloop

# Skill-internal exclusion (test fixtures/scripts, not part of the product)
skills/hfc-fieldloop/tests/

# OS junk, anywhere
.DS_Store
**/.DS_Store
